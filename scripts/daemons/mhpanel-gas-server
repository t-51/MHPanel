#!/usr/bin/env python3
"""
MHPanel - Google Apps Script (GAS) Full Tunnel Manager & Fallback Engine
Launches the native Rust mhrv-tunnel-node (MasterHttpRelayVPN-RUST) if compatible with OS/GLIBC.
Seamlessly falls back to high-performance async Python relay engine when GLIBC < 2.32.
"""
import os
import sys
import json
import base64
import asyncio
import socket
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler

CONFIG_FILE = "/etc/vpnpanel/google_script.json"
DEFAULT_CONFIG = {
    "port": 8448,
    "secret": "mhpanel_gas_secret_key_2026",
    "mode": "full_tunnel"
}

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg.update(json.load(f))
        except Exception:
            pass
    return cfg

# In-memory session store for Python fallback engine
active_sessions = {}

class GasFallbackHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, format, *args):
        # Silence standard HTTP logs for performance
        pass

    def _send_json(self, status_code, data):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def _send_text(self, status_code, text):
        body = text.encode("utf-8")
        self.send_response(status_code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path in ("/", "/health"):
            self._send_text(200, "ok")
        elif self.path == "/stats":
            self._send_json(200, {
                "active_sessions": len(active_sessions),
                "engine": "python-async-fallback",
                "status": "online"
            })
        else:
            self._send_text(404, "Not Found")

    def do_POST(self):
        cfg = load_config()
        expected_key = cfg.get("secret", "")
        
        content_length = int(self.headers.get("Content-Length", 0))
        if content_length <= 0:
            self._send_text(400, "Bad Request")
            return
            
        try:
            raw_body = self.rfile.read(content_length)
            payload = json.loads(raw_body.decode("utf-8"))
        except Exception:
            self._send_text(400, "Invalid JSON")
            return

        # Check authentication key
        client_key = payload.get("k", "")
        if client_key != expected_key:
            self._send_text(401, "Unauthorized")
            return

        if self.path == "/tunnel":
            resp = self._handle_tunnel_op(payload)
            self._send_json(200, resp)
        elif self.path == "/tunnel/batch":
            ops = payload.get("ops", [])
            results = []
            for op in ops:
                results.append(self._handle_tunnel_op(op))
            self._send_json(200, {"ok": True, "results": results})
        else:
            self._send_text(404, "Not Found")

    def _handle_tunnel_op(self, op_data):
        op = op_data.get("op", "")
        sid = op_data.get("sid", "")
        
        if op == "connect":
            host = op_data.get("host", "127.0.0.1")
            port = int(op_data.get("port", 80))
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(3.0)
                s.connect((host, port))
                s.setblocking(False)
                active_sessions[sid] = s
                return {"ok": True, "sid": sid, "status": "connected"}
            except Exception as e:
                return {"ok": False, "sid": sid, "error": str(e)}

        elif op == "data":
            s = active_sessions.get(sid)
            if not s:
                return {"ok": False, "sid": sid, "error": "session_not_found"}
            
            in_data = op_data.get("data", "")
            if in_data:
                try:
                    raw_bytes = base64.b64decode(in_data)
                    s.sendall(raw_bytes)
                except Exception as e:
                    return {"ok": False, "sid": sid, "error": f"write_error: {e}"}

            out_b64 = ""
            try:
                chunk = s.recv(65536)
                if chunk:
                    out_b64 = base64.b64encode(chunk).decode("utf-8")
            except (BlockingIOError, socket.error):
                pass
            except Exception:
                pass
            return {"ok": True, "sid": sid, "data": out_b64}

        elif op == "close":
            s = active_sessions.pop(sid, None)
            if s:
                try:
                    s.close()
                except Exception:
                    pass
            return {"ok": True, "sid": sid, "status": "closed"}

        return {"ok": False, "error": f"unsupported_op_{op}"}


def main():
    cfg = load_config()
    port = int(cfg.get("port", 8448))
    secret = str(cfg.get("secret", "mhpanel_gas_secret_key_2026"))
    
    os.makedirs("/etc/vpnpanel", exist_ok=True)
    try:
        with open("/etc/vpnpanel/gas_tunnel.env", "w", encoding="utf-8") as f:
            f.write(f"PORT={port}\nTUNNEL_AUTH_KEY={secret}\nMHRV_DIAGNOSTIC=0\n")
    except Exception:
        pass

    rust_bin = "/usr/local/bin/mhrv-tunnel-node"
    if os.path.isfile(rust_bin) and os.access(rust_bin, os.X_OK):
        # Validate that the binary executes without GLIBC symbol errors
        try:
            check = subprocess.run([rust_bin, "--version"], capture_output=True, timeout=2)
            if check.returncode == 0:
                print(f"[*] Starting native Rust mhrv-tunnel-node on port {port}...")
                os.environ["PORT"] = str(port)
                os.environ["TUNNEL_AUTH_KEY"] = secret
                os.environ["MHRV_DIAGNOSTIC"] = "0"
                os.execv(rust_bin, [rust_bin])
            else:
                print(f"[!] Warning: {rust_bin} failed GLIBC runtime check. Switching to Python fallback.")
        except Exception as e:
            print(f"[!] Warning: Native execution check failed ({e}). Switching to Python fallback.")

    print(f"[*] Starting MHPanel Python Async GAS Tunnel Engine on port {port}...")
    server = HTTPServer(("0.0.0.0", port), GasFallbackHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()

if __name__ == "__main__":
    main()
