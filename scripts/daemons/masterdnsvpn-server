def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                cfg = json.load(f)
                res = DEFAULT_CONFIG.copy()
                res.update(cfg)
                return res
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()

def build_dns_response(req_data, payload_bytes=b""):
    """
    Builds a standard DNS response with NULL or TXT answer record containing data.
    """
    if len(req_data) < 12:
        return b""
    qid = req_data[:2]
    flags = b"\x81\x80" # Standard response, No error
    qdcount = req_data[4:6]
    ancount = b"\x00\x01" # 1 Answer
    nscount = b"\x00\x00"
    arcount = b"\x00\x00"

    # Find end of question
    idx = 12
    while idx < len(req_data):
        length = req_data[idx]
        if length == 0:
            idx += 5 # 1 byte zero + 2 bytes qtype + 2 bytes qclass
            break
        idx += 1 + length

    question_sec = req_data[12:idx]
    
    # Answer: Pointer to name (0xc00c), Type TXT (16), Class IN (1), TTL (10s), Data
    ans_name = b"\xc0\x0c"
    ans_type = struct.pack(">H", 16) # TXT
    ans_class = struct.pack(">H", 1) # IN
    ans_ttl = struct.pack(">I", 10)
    
    # TXT format: length byte + data (chunked to 255 if needed)
    txt_payload = b""
    encoded = base64.b64encode(payload_bytes)
    offset = 0
    while offset < len(encoded):
        chunk = encoded[offset:offset+250]
        txt_payload += struct.pack("B", len(chunk)) + chunk
        offset += len(chunk)

    ans_rdlen = struct.pack(">H", len(txt_payload))
    answer_sec = ans_name + ans_type + ans_class + ans_ttl + ans_rdlen + txt_payload

    return qid + flags + qdcount + ancount + nscount + arcount + question_sec + answer_sec

